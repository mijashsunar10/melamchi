# Copy to .env and fill in real values. (.env is never committed to git.)

# Public site URL (used for SEO / Open Graph links)
NEXT_PUBLIC_SITE_URL=https://topxnepal.com

# Contact — starting values only: after the first save, these are edited in Admin → Settings
# WhatsApp number in international format, digits only (977 + number)
NEXT_PUBLIC_WHATSAPP_NUMBER=9779844602730
NEXT_PUBLIC_SUPPORT_EMAIL=mijashsunar1@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=+977 9844602730
# Inbox that gets an email copy of every order, support message and reseller form (via FormSubmit;
# the first email asks you to click "Activate" once). Leave empty to turn emails off.
NEXT_PUBLIC_ORDER_EMAIL=mijashsunar1@gmail.com
NEXT_PUBLIC_ADDRESS=Kathmandu, Nepal
NEXT_PUBLIC_MAP_URL=https://maps.google.com/?q=Kathmandu,Nepal
NEXT_PUBLIC_OFFICE_HOURS=Sun–Fri, 10:00 AM – 6:00 PM

# Social links
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/1LrubhTUX7/
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Backend ---
# PostgreSQL connection (the database you see in pgAdmin)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/topx_nepal
# eSewa — test keys below; for real payments use the merchant code + secret from eSewa and ESEWA_ENV=live.
# Leave ESEWA_SECRET_KEY empty to hide the eSewa button.
ESEWA_ENV=test
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# KHALTI_SECRET_KEY=

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorized redirect URI: http://localhost:3000/auth/google/callback  (and https://YOUR-DOMAIN/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret for the eSewa missed-payment cron (/api/cron/esewa)
CRON_SECRET=
# Supplier auto top-up — leave empty until the supplier API is connected
TOPUP_API_KEY=

# Signs password-reset links — any long random string
AUTH_SECRET=
# Email to customers (password reset, order status). Gmail: smtp.gmail.com / 465 / your Gmail / an App Password
# (Google Account → Security → 2-Step Verification → App passwords). Leave SMTP_HOST empty in dev: emails print in the terminal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TopX <you@gmail.com>"
